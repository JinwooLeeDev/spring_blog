{{> layout/header}}

<div class="container p-5">

    {{#isOwner}}
        <div class="d-flex justify-content-end">
            <a href="/board/{{board.id}}/update" class="btn btn-warning me-1">수정</a>
            <form action="/board/{{board.id}}/delete" method="post">
                <button class="btn btn-danger">삭제</button>
            </form>
        </div>
    {{/isOwner}}

    <div class="d-flex justify-content-end">
        <b>작성자</b> : {{board.username}}
    </div>

    <div>
        <h2><b>{{board.title}}</b></h2>
        <hr>
        <div class="m-4 p-2">
            {{board.content}}
        </div>
    </div>

    {{! DB에서 조회한 해당 게시글의 댓글을 표시합니다 }}
    <div class="card mt-3">
        <div class="card-body">
            <form action="/reply/save" method="post">
                <input type="hidden" name="boardId" value="{{board.id}}">
                <textarea class="form-control" rows="2" name="comment" placeholder="댓글을 입력하세요"></textarea>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary mt-1">댓글 등록</button>
                </div>
            </form>
        </div>
        <div class="card-footer"><b>댓글 목록</b></div>
        <div class="list-group">
            {{#replyList}}
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div style="min-width: 0;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="px-1 bg-primary text-white rounded">{{username}}</span>
                        {{#createdAt}}<small class="text-muted">{{createdAt}}</small>{{/createdAt}}
                    </div>
                    <div style="white-space: pre-wrap; overflow-wrap: anywhere;">{{comment}}</div>
                </div>
                {{#isOwner}}
                <form action="/reply/{{id}}/delete" method="post" class="ms-2 flex-shrink-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="댓글 삭제">삭제</button>
                </form>
                {{/isOwner}}
            </div>
            {{/replyList}}
            {{^replyList}}
                <div class="list-group-item text-muted">아직 댓글이 없습니다.</div>
            {{/replyList}}
        </div>
    </div>
</div>

{{> layout/footer}}
